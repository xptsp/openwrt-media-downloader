#!/bin/bash

# Tell user when this update started:
echo "[$(date '+%Y-%m-%d %H:%M:%S')] Beginning Copy process..."

# Function to hash files and copy if changed:

RESTART=n
hashcopy() {
	local HASH="$(grep $1 .hash | cut -d" " -f 1)"
	if [[ ! -z "${HASH}" ]]; then
		[[ "$(grep $HASH .hash_new | awk '{print $1}')" == "$HASH" ]] && return
	fi
	scp $1 $2
	[[ "$1" == "files/media-downloader.init" || "$1" == "files/media-downloader.py" ]] && RESTART=y
}

# Copy files over ONLY if they have changed:
touch .hash
sha256sum files/* > .hash_new
hashcopy files/media-downloader.py root@homelab.lan:/usr/libexec/media-downloader/media-downloader.py
hashcopy files/index.html root@homelab.lan:/usr/share/media-downloader/index.html
hashcopy files/wallpaper.webp root@homelab.lan:/usr/share/media-downloader/wallpaper.webp
hashcopy files/manifest.json root@homelab.lan:/usr/share/media-downloader/manifest.json
hashcopy files/sw.js root@homelab.lan:/usr/share/media-downloader/sw.js
hashcopy files/app-icon.png root@homelab.lan:/usr/share/media-downloader/app-icon.png
hashcopy files/no-poster.svg root@homelab.lan:/usr/share/media-downloader/no-poster.svg
hashcopy files/style.css root@homelab.lan:/usr/share/media-downloader/style.css
hashcopy files/media-downloader.init root@homelab.lan:/etc/init.d/media-downloader
mv .hash_new .hash

# Replace the crontab line in the /etc/crontabs/root file:
scp files/media-downloader.crontab root@homelab.lan:/tmp/media-downloader.crontab && ssh root@homelab.lan 'sh -s' <<'REMOTE'
set -e
crontab=/etc/crontabs/root
mkdir -p /etc/crontabs
tmp=$(mktemp /etc/crontabs/.media-downloader.XXXXXX)
trap 'rm -f "$tmp" /tmp/media-downloader.crontab' 0

if [ -f "$crontab" ]; then
    awk 'index($0, "/usr/libexec/media-downloader/media-downloader.py --cron") == 0 && index($0, "/usr/libexec/media-downloader.py --cron") == 0 { print }' "$crontab" > "$tmp"
fi
cat /tmp/media-downloader.crontab >> "$tmp"
chmod 600 "$tmp"
mv "$tmp" "$crontab"

if [ -f /etc/crontabs/media-downloader ] && grep -Fq '/usr/libexec/media-downloader.py --cron' /etc/crontabs/media-downloader; then
    rm -f /etc/crontabs/media-downloader
fi

if [ -x /etc/init.d/cron ]; then
    /etc/init.d/cron restart
else
    logger -t media-downloader "Cron init script not found; scheduled job was installed but will not run."
fi
REMOTE

# Restart the service if the init.d script or python script was replaced:
if [[ "${RESTART}" == "y" ]]; then
    ssh root@homelab.lan service media-downloader restart || exit 1
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Service restarted..."
fi
