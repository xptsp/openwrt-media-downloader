#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

# Name of your configuration file in /etc/config/
CONFIG_NAME="media-downloader"

start_service() {
    # Optional: Read global settings from UCI if needed
    config_load "$CONFIG_NAME"
    
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/libexec/media-downloader.py
    
    # Respawn logic if the script crashes
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    
    # Catch Python print() statements directly in logread
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    # Automatically triggers a reload/restart if /etc/config/media-downloader changes
    procd_add_reload_trigger "$CONFIG_NAME"
}

reload_service() {
    # Handles soft-reloads gracefully when configuration updates
    rc_procd reload_service "$@"
}
