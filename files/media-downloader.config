
config global 'main'
	option bind_address '0.0.0.0'
	option port '8080'
	option base_dir '/mnt/sda1/KDramas'
	option cache_dir '/mnt/sda1/KDramas/.media-downloader-cache'
	option movies_dir '/mnt/sda1/KMovies'
	option directory_browser_root ''
	option auth_enabled '0'
	option auth_username 'admin'
	option auth_password 'admin'
	option allowed_domains 'thenkiri.com,dramakey.com,9jarocks.com'
	option ntfy_topic ''
	option ntfy_enabled '1'
	option vapid_subject 'mailto:admin@example.com'
	option theme_mode 'auto'
	option default_series_view 'gallery'

