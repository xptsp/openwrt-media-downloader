#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

# Name of your configuration file in /etc/config/
CONFIG_NAME="media-downloader"
SESSION_SAVE_ACK_FILE="/tmp/media-downloader.sessions.saved"

start_service() {
    # Optional: Read global settings from UCI if needed
    config_load "$CONFIG_NAME"
    
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/libexec/media-downloader/media-downloader.py
    
    # Respawn logic if the script crashes
    procd_set_param respawn ${respawn_threshold:-3600} ${respawn_timeout:-5} ${respawn_retry:-5}
    
    # Catch Python print() statements directly in logread
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    rm -f "$SESSION_SAVE_ACK_FILE"

    if ! procd_send_signal "$CONFIG_NAME" "*" USR1 >/dev/null 2>&1; then
        return 0
    fi

    attempts=0
    while [ "$attempts" -lt 50 ]; do
        if [ -f "$SESSION_SAVE_ACK_FILE" ]; then
            rm -f "$SESSION_SAVE_ACK_FILE"
            return 0
        fi
        sleep 0.1
        attempts=$((attempts + 1))
    done

    logger -t media-downloader "Timed out waiting for the login-session dump before stopping."
}

service_triggers() {
    # Automatically triggers a reload/restart if /etc/config/media-downloader changes
    procd_add_reload_trigger "$CONFIG_NAME"
}

reload_service() {
    # Handles soft-reloads gracefully when configuration updates
    rc_procd reload_service "$@"
}
